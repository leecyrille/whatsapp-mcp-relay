{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WA Relay",
  "version": "1.2.20",
  "identifier": "app.warelay.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: http://wamedia.localhost",
        "media-src": "'self' blob: http://wamedia.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost http://wamedia.localhost",
        "font-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "http://wamedia.localhost"
      },
      "capabilities": [
        "main"
      ]
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "warelay"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNFNzE2OTQ5MkExRTUxMkEKUldRcVVSNHFTV2x4UG5NUmQxdUlFRmtSSUVYcG5tTGpHeWxFQlVhR2RhU1ZQbjZyVjdSdUtadncK",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "quiet"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "WA Relay"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "publisher": "WA Relay"
  }
}
